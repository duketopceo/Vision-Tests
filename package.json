{
  "name": "argus-reviewer-e2e",
  "version": "0.1.0",
  "description": "argus-reviewer \u2014 open-source vision-model E2E testing harness. Record, replay, heal, and assert with any OpenRouter model under a hard budget cap.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "argus-reviewer": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/api.js",
    "./api": "./dist/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "action"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build && chmod +x dist/cli.js",
    "eval": "node evals/run.mjs",
    "watch": "node scripts/watch.mjs",
    "app": "electron electron"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "electron": "^44.2.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/argus-reviewer.git"
  }
}
